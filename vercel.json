{
  "buildCommand": "cd frontend && npm install --legacy-peer-deps && GENERATE_SOURCEMAP=false CI=false npm run build",
  "outputDirectory": "frontend/build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|uploads/|static/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
